# ─── Secrets & key material (NEVER commit) ────────────────────────────────
# TLS / mTLS certs and private keys
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx
*.der
*.srl
# CA material generated by the agent
ca.pem
ca.key
# Confidant secret envelopes / dev KEK / DEKs / stores
*.envelope
*.dek
*.kek
dev-kek*
dev.kek
store.json
secrets/
# OAuth / token dumps
*.token
*.refresh

# ─── Local config that may carry endpoints / identity ─────────────────────
.env
.env.*
*.local.toml
*.local.json
agent.local.toml
agent.json
# keep example/committed configs: agent.example.toml is intentionally tracked

# ─── Docs working area (not published) ────────────────────────────────────
docs/blog/

# ─── Audit output ─────────────────────────────────────────────────────────
audit/
*.audit
*.audit.log
audit.log

# ─── Go build artifacts ───────────────────────────────────────────────────
/bin/
proxy/confidant-proxy
agent/confidant-agent
*.exe
*.test
*.out
coverage.*
/vendor/

# ─── Editor / OS ──────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.DS_Store
*.swp
